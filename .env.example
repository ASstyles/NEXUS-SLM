# NEXUS-SLM Environment Variables
ENV=development
API_PORT=8000
API_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Model & Storage Settings
NEXUS_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
NEXUS_ADAPTER_PATH=./models/nexus-v1.0
NEXUS_DEVICE=auto
NEXUS_QUANTIZATION=4bit

# Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=nexus-slm-triage

# Benchmark APIs (Optional - Pluggable Large LLM Benchmark)
# Leave blank to mark Large LLM benchmark as NOT RUN without breaking the pipeline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Telemetry & Monitoring
ENABLE_TELEMETRY=true
TELEMETRY_STORAGE_PATH=./monitoring/telemetry.jsonl
