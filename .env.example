# ==============================================================================
# NEXUS-SLM Environment Configuration Template
# WARNING: Do NOT commit secrets, private API keys, or credentials to Git.
# Copy this template to .env for local deployment: cp .env.example .env
# ==============================================================================

# Application Environment & Logging
# Options: production | development | test
NEXUS_ENV=production
NEXUS_DEBUG=false

# API Server Host and Port
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000

# Security & Administrative Credentials
# CRITICAL: In production, NEXUS_ADMIN_KEY is mandatory and MUST be at least 32 characters long.
# Default/placeholder keys (e.g. 'nexus-admin-secret-key-change-in-prod') will cause production startup to abort.
# Generate a cryptographically strong key via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_ADMIN_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
NEXUS_ENFORCE_ADMIN_AUTH=true

# Reverse Proxy & Trusted Proxy Configuration
# Comma-separated list of trusted upstream proxy IP addresses (e.g., NGINX, Cloudflare, Traefik).
# X-Forwarded-For headers from untrusted direct clients will be ignored to prevent IP spoofing.
NEXUS_TRUSTED_PROXIES=127.0.0.1,::1

# CORS Allowed Origins
# Comma-separated list of origins. In production, specify exact client domains.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Traffic, Concurrency & Rate Limiting SLAs
NEXUS_RATE_LIMIT_PER_MINUTE=120
NEXUS_REQUEST_TIMEOUT_SECONDS=30.0
NEXUS_CONCURRENCY_LIMIT=25
NEXUS_MAX_PAYLOAD_CHARS=4000

# Rate Limiter Backend Architecture
# Options: memory (single node / development) | redis (distributed multi-replica production)
NEXUS_RATE_LIMITING_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Privacy & Adversarial Guards
NEXUS_PII_REDACTION=true
NEXUS_PROMPT_INJECTION_GUARD=true

# Model Versioning & Weights Resolution
# Active candidate version registered in models/registry.json
ACTIVE_MODEL_VERSION=nexus-qlora-v1
# Optional explicit adapter directory override
NEXUS_ADAPTER_PATH=

# Operational Telemetry Storage
TELEMETRY_LOG_FILE=monitoring/telemetry.jsonl
