# ==============================================================================
# NEXUS-SLM Environment Configuration (Template / Placeholders Only)
# WARNING: Do NOT commit secrets or real credentials to source control.
# Copy this file to .env for local deployment: cp .env.example .env
# ==============================================================================

# Application Environment
ENV=production
API_PORT=8000
API_HOST=0.0.0.0
ACTIVE_MODEL_VERSION=nexus-qlora-v1

# Security & CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1048576
MAX_TICKET_CHARS=4000
RATE_LIMIT_PER_MINUTE=120

# Model & Device Configuration
NEXUS_BASE_MODEL=HuggingFaceTB/SmolLM-135M-Instruct
NEXUS_ADAPTER_PATH=models/nexus_qlora_v1
NEXUS_DEVICE=cpu
NEXUS_PRECISION=fp32

# Telemetry & Observability
ENABLE_TELEMETRY=true
TELEMETRY_STORAGE_PATH=monitoring/telemetry.jsonl
LOG_SENSITIVE_TEXT=false
LOG_LEVEL=INFO

# Experiment Tracking (Optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nexus-slm-triage

# External Benchmark APIs (Optional - Pluggable Large LLM Benchmark Only)
# Leave blank to preserve offline air-gapped operation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
